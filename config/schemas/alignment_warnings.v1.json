          "title": "Routing Target",
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "summary",
        "evidence",
        "routing_target"
      ],
      "title": "AlignmentWarning",
      "type": "object"
    },
    "EvidencePointer": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "artifact_ref": {
          "title": "Artifact Ref",
          "type": "string"
        },
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "json_pointer": {
          "title": "Json Pointer",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
