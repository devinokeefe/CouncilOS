{
  "title": "ChangeRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string"},
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "impl_run_id": {"type": "string"},
        "source_plan_hash": {"type": "string"}
      },
      "required": ["impl_run_id", "source_plan_hash"]
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string"},
        "summary": {"type": "string"}
      },
      "required": ["code", "summary"]
    },
    "blocked_entities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_ids": {"type": "array", "items": {"type": "string"}},
        "job_ids": {"type": "array", "items": {"type": "string"}},
        "check_ids": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["task_ids", "job_ids", "check_ids"]
    },
    "evidence_refs": {"type": "array", "items": {"type": "object"}},
    "proposed_plan_edits_ref": {"type": ["string", "null"]},
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "milestones_affected": {"type": "array", "items": {"type": "string"}},
        "checks_affected": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["milestones_affected", "checks_affected"]
    }
  },
  "required": [
    "schema_version",
    "meta",
    "reason",
    "blocked_entities",
    "evidence_refs",
    "proposed_plan_edits_ref",
    "impact"
  ]
}
