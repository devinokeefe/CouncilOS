{
  "$defs": {
    "DependencyPolicy": {
      "additionalProperties": false,
      "properties": {
        "network_installs_allowed": {
          "default": false,
          "title": "Network Installs Allowed",
          "type": "boolean"
        },
        "required_lockfiles": {
          "items": {
            "type": "string"
          },
          "title": "Required Lockfiles",
          "type": "array"
        }
      },
      "title": "DependencyPolicy",
      "type": "object"
    },
    "ExecutionProfilesConfig": {
      "additionalProperties": false,
      "properties": {
        "catalog_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Ref"
        },
        "allowed_profile_ids": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Profile Ids",
          "type": "array"
        },
        "default_profile_id_by_stage": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Default Profile Id By Stage",
          "type": "object"
        }
      },
      "title": "ExecutionProfilesConfig",
      "type": "object"
    },
    "RepoBuildEntrypoint": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "working_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Working Dir"
        }
      },
      "required": [
        "name",
        "command"
      ],
      "title": "RepoBuildEntrypoint",
      "type": "object"
    },
    "RepoValidatorEntrypoint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "command": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "mode": {
          "default": "command",
          "enum": [
            "command",
            "mock"
          ],
          "title": "Mode",
          "type": "string"
        },
        "outcomes": {
          "items": {
            "enum": [
              "pass",
              "fail"
            ],
            "type": "string"
          },
          "title": "Outcomes",
          "type": "array"
        },
        "maps_to_acceptance_tests": {
          "items": {
            "type": "string"
          },
          "title": "Maps To Acceptance Tests",
          "type": "array"
        },
        "retryable": {
          "default": true,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "RepoValidatorEntrypoint",
      "type": "object"
    },
    "ValidatorRunner": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "cmd": {
          "title": "Cmd",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        }
      },
      "required": [
        "name",
        "cmd",
        "profile_id"
      ],
      "title": "ValidatorRunner",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "repo_root": {
      "title": "Repo Root",
      "type": "string"
    },
    "base_commit": {
      "title": "Base Commit",
      "type": "string"
    },
    "head_commit": {
      "title": "Head Commit",
      "type": "string"
    },
    "branch_name": {
      "title": "Branch Name",
      "type": "string"
    },
    "build_entrypoints": {
      "items": {
        "$ref": "#/$defs/RepoBuildEntrypoint"
      },
      "title": "Build Entrypoints",
      "type": "array"
    },
    "validator_entrypoints": {
      "items": {
        "$ref": "#/$defs/RepoValidatorEntrypoint"
      },
      "title": "Validator Entrypoints",
      "type": "array"
    },
    "protected_paths": {
      "items": {
        "type": "string"
      },
      "title": "Protected Paths",
      "type": "array"
    },
    "forbidden_paths": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Paths",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "execution_profiles": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionProfilesConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "validator_runners": {
      "items": {
        "$ref": "#/$defs/ValidatorRunner"
      },
      "title": "Validator Runners",
      "type": "array"
    },
    "dependency_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/DependencyPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "repo_root",
    "base_commit",
    "head_commit",
    "branch_name",
    "build_entrypoints",
    "validator_entrypoints",
    "protected_paths",
    "forbidden_paths"
  ],
  "title": "RepoContextPayloadV2",
  "type": "object"
}