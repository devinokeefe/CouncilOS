{
  "$defs": {
    "EvidencePointer": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "title": "Artifact Ref",
          "type": "string"
        },
        "entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "json_pointer": {
          "title": "Json Pointer",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "artifact_ref",
        "json_pointer"
      ],
      "title": "EvidencePointer",
      "type": "object"
    },
    "ReviewFinding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidencePointer"
          },
          "title": "Evidence",
          "type": "array"
        },
        "violated_gate": {
          "title": "Violated Gate",
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "summary",
        "evidence",
        "violated_gate"
      ],
      "title": "ReviewFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/ReviewFinding"
      },
      "title": "Findings",
      "type": "array"
    }
  },
  "required": [
    "findings"
  ],
  "title": "ReviewFindingsPayload",
  "type": "object"
}