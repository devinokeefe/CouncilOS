{
  "$defs": {
    "EvidencePointer": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "title": "Artifact Ref",
          "type": "string"
        },
        "entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "json_pointer": {
          "title": "Json Pointer",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "artifact_ref",
        "json_pointer"
      ],
      "title": "EvidencePointer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "intent_id": {
      "title": "Intent Id",
      "type": "string"
    },
    "applied_at": {
      "format": "date-time",
      "title": "Applied At",
      "type": "string"
    },
    "status": {
      "enum": [
        "applied",
        "failed",
        "rolled_back"
      ],
      "title": "Status",
      "type": "string"
    },
    "pre_snapshot_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pre Snapshot Ref"
    },
    "post_snapshot_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Post Snapshot Ref"
    },
    "drift_report_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Drift Report Ref"
    },
    "rollback_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rollback Status"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidencePointer"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "intent_id",
    "applied_at",
    "status"
  ],
  "title": "ApplyRecordPayload",
  "type": "object"
}