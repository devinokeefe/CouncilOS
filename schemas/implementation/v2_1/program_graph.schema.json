    "ProgramGraphNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "expectation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Expectation Ids",
          "type": "array"
        },
        "required_evidence": {
          "items": {
            "$ref": "#/$defs/ProgramGraphRequiredEvidence"
          },
          "title": "Required Evidence",
          "type": "array"
        },
        "policy_gates": {
          "items": {
            "$ref": "#/$defs/ProgramGraphPolicyGate"
          },
          "title": "Policy Gates",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "ProgramGraphNode",
      "type": "object"
    },
    "ProgramGraphPolicyGate": {
      "additionalProperties": false,
      "properties": {
        "gate_id": {
          "title": "Gate Id",
          "type": "string"
        },
        "requires_hitl": {
          "default": false,
          "title": "Requires Hitl",
          "type": "boolean"
        },
        "waiver_allowed": {
          "default": true,
          "title": "Waiver Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "gate_id"
      ],
      "title": "ProgramGraphPolicyGate",
      "type": "object"
    },
    "ProgramGraphRequiredEvidence": {
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "title": "Artifact Type",
          "type": "string"
        },
        "env_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Env Class"
        }
      },
      "required": [
        "artifact_type"
      ],
      "title": "ProgramGraphRequiredEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "title": "Schema Version",
      "type": "string"
