{
  "title": "PlanPackageVNext",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string"},
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "plan_status": {"type": "string"},
        "plan_version": {"type": "integer"},
        "parent_plan_hash": {"type": ["string", "null"]},
        "amendment_id": {"type": ["string", "null"]},
        "hash_spec_version": {"type": "string"}
      },
      "required": [
        "plan_status",
        "plan_version",
        "parent_plan_hash",
        "amendment_id",
        "hash_spec_version"
      ]
    },
    "problem": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "statement": {"type": "string"},
        "intent_summary": {"type": "string"},
        "non_goals": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["statement", "intent_summary", "non_goals"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "in_scope_paths": {"type": "array", "items": {"type": "string"}},
        "out_of_scope_paths": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["in_scope_paths", "out_of_scope_paths"]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "caps": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "max_files_changed": {"type": "integer"},
            "max_loc_changed": {"type": "integer"},
            "max_dep_changes": {"type": "integer"}
          },
          "required": ["max_files_changed", "max_loc_changed", "max_dep_changes"]
        }
      },
      "required": ["caps"]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"}
        },
        "required": ["id", "text"]
      }
    },
    "work_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "maps_to_requirements": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["id", "title", "maps_to_requirements"]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string"},
          "required_env_class": {"type": "string"},
          "oracle": {"type": "object"}
        },
        "required": ["id", "severity", "required_env_class", "oracle"]
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"},
          "required_check_ids": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["id", "required_check_ids"]
      }
    }
  },
  "required": [
    "schema_version",
    "meta",
    "problem",
    "scope",
    "constraints",
    "requirements",
    "work_items",
    "checks",
    "milestones"
  ]
}
